<Window x:Class="FileDesk.Desktop.ExitWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="pack://application:,,,/FileDesk;component/Assets/file-desk.ico"
 Title="Exit File Desk" Width="650" Height="390" MinWidth="480" MinHeight="260"
 WindowStartupLocation="CenterScreen" Background="#F8F8F9">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="Heading" Text="Tasks are still running" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
  <ListBox x:Name="TaskList" Grid.Row="1" BorderBrush="#E4E4E7" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Active tasks">
   <ListBox.ItemTemplate><DataTemplate>
    <StackPanel Margin="8">
     <DockPanel><TextBlock Text="{Binding Operation}" FontWeight="SemiBold" Margin="0,0,12,0"/><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/></DockPanel>
     <TextBlock Text="{Binding Phase}" Foreground="#71717A" Margin="0,4,0,4"/>
     <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Percentage}" IsIndeterminate="{Binding Indeterminate}"/>
     <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#71717A" Margin="0,4,0,0"/>
    </StackPanel>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <TextBlock x:Name="Warning" Grid.Row="2" Text="Termination cancels transfers. Completed changes stay applied. A folder deletion may be partially complete."
    TextWrapping="Wrap" Foreground="#9C2929" Margin="0,12,0,16"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Keep running" IsCancel="True" Click="KeepRunning"/>
   <Button x:Name="TerminateButton" Content="Terminate and exit" Click="Terminate"/>
  </StackPanel>
 </Grid>
</Window>
