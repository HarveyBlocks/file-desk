<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FileDesk</AssemblyName>
    <RootNamespace>FileDesk.Desktop</RootNamespace>
    <ApplicationIcon>../assets/file-desk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><Resource Include="../assets/file-desk.ico" Link="Assets/file-desk.ico"/></ItemGroup>
</Project>
