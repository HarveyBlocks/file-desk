<Window x:Class="FileDesk.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="pack://application:,,,/FileDesk;component/Assets/file-desk.ico"
 Title="File Desk" Width="900" Height="560" MinWidth="540" MinHeight="320"
 Background="#F8F8F9" Closing="OnClosing">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <CheckBox x:Name="AutoScroll" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <Button Content="Clear" Click="ClearLogs"/>
    <Button x:Name="RetryButton" Content="Retry" Click="RetryService" Visibility="Collapsed"/>
   </StackPanel>
   <StackPanel><TextBlock Text="File Desk" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock x:Name="StatusText" Text="Starting" Foreground="#71717A" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <RichTextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True"
   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
   FontSize="12" Padding="12" BorderBrush="#E4E4E7" AutomationProperties.Name="Service logs">
   <FlowDocument PagePadding="0" LineHeight="20">
    <FlowDocument.Resources><Style TargetType="Paragraph">
     <Setter Property="Margin" Value="0"/><Setter Property="LineHeight" Value="20"/>
     <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style></FlowDocument.Resources>
    <Paragraph/>
   </FlowDocument>
  </RichTextBox>
 </Grid>
</Window>
